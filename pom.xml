<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>dk.certops</groupId>
    <artifactId>certops-agent</artifactId>
    <version>1.4.0</version>
    <name>CertWatch Pro Agent</name>
    <description>On-premise TLS scanner agent for CertWatch Pro</description>

    <properties>
        <java.version>17</java.version>
        <!--
            Jackson 2 (brugt internt af agenten). Boot 4.1.0 manages 2.21.4, which still carries
            GHSA-5jmj-h7xm-6q6v (case-insensitive deserialization bypasses per-property
            @JsonIgnoreProperties); 2.22.2 is the newest 2.x and closes it.
            'jackson-bom.version' is Jackson *3* under Boot 4 — newest patch on the 3.1 line Boot
            manages (3.2.x would be a minor bump outside it).
        -->
        <!--
            Fremad-pins oven på Boot 4.1.0's BOM (som leverer Spring Framework 7.0.8).
            Fjern dem igen, når parent-BOM'en selv leverer mindst disse versioner — et pin må
            aldrig ende med at trække NED.
        -->
        <spring-framework.version>7.0.9</spring-framework.version>
        <jackson-2-bom.version>2.22.3</jackson-2-bom.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <!-- Only log4j-api + log4j-to-slf4j are on the classpath (a bridge, not the log engine). -->
        <log4j2.version>2.26.1</log4j2.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!--
            NOT spring-boot-starter-web: the agent exposes no HTTP endpoints and talks to
            the cloud over java.net.http.HttpClient. The starter only added an embedded
            Tomcat listening on a random port inside the customer's network, plus the
            spring-web/spring-webmvc CVE surface. Keep this app non-web.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- java.time support for the ObjectMapper in JacksonConfig; previously transitive via starter-web. -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
